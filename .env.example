# Base de datos (Prisma / Postgres). No commitear valores reales.
DATABASE_URL=
DIRECT_URL=

# Supabase. La anon key es pública; la service role solo se usa en servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app. Opcional: en Vercel se usa VERCEL_URL.
NEXT_PUBLIC_APP_URL=

# ARCA homologación. Base64 del PEM completo. Solo servidor. No usar NEXT_PUBLIC_.
ARCA_HOMO_CERT_B64=
ARCA_HOMO_PRIVATE_KEY_B64=

# ARCA producción. Solo servidor. No usar NEXT_PUBLIC_.
ARCA_PROD_CERT_B64=
ARCA_PROD_PRIVATE_KEY_B64=

# Kill switch de emisión productiva. Solo el valor exacto true habilita. Solo servidor.
ARCA_PRODUCTION_EMISSION_ENABLED=false

# Clave AES-256 para cifrar el Ticket WSAA. Exactamente 32 bytes en Base64. Solo servidor.
ARCA_TICKET_ENCRYPTION_KEY_B64=
