// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  VISITANTE
  VENDEDOR
  VISITANTE_AVANZADO
  ADMINISTRADOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
  HIDDEN
}

enum FolderStatus {
  ACTIVE
  INACTIVE
}

enum ColumnDataType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  DATETIME
  IMAGE
  FORMULA
  UNKNOWN
}

enum UploadedFileStatus {
  STORED
  PROCESSING
  PROCESSED
  FAILED
}

enum ImportJobStatus {
  STORED
  ANALYZING
  PENDING_DESTINATION
  PENDING_CONFIG
  PROCESSING
  READY_TO_APPLY
  PENDING_REVIEW
  PUBLISHED
  FAILED
  CANCELLED
}

enum ProductImageStatus {
  ASSOCIATED_AUTO
  ASSOCIATED_MANUAL
  PENDING_REVIEW
  FILE_NOT_FOUND
  AMBIGUOUS
  DUPLICATE_NAME
  FORMAT_REJECTED
  DELETED
}

enum ProductImageSource {
  EMBEDDED
  EXTERNAL_ZIP
  EXTERNAL_UPLOAD
  MANUAL
}

enum ImportActionType {
  IMPORTAR_LISTA
  COMBINAR_LISTA
  REEMPLAZAR_LISTA
}

enum ImportSheetClassification {
  IMPORTABLE
  INDEX
  AUXILIARY
  IGNORED
}

enum ImportDestinationType {
  CATALOG_FOLDER
  PRICE_LIST
}

enum PriceListStatus {
  ACTIVE
  INACTIVE
}

enum BillingIdentificationType {
  CUIT
  DNI
  NINGUNO
}

enum BillingIvaCondition {
  RESPONSABLE_INSCRIPTO
  RESPONSABLE_NO_INSCRIPTO
  MONOTRIBUTISTA
  CONSUMIDOR_FINAL
  EXENTO
}

enum BillingRubroStatus {
  ACTIVE
  INACTIVE
}

enum BillingInvoiceType {
  A
  B
}

enum BillingFiscalEnvironment {
  MODO_PRUEBA
  HOMOLOGACION
  PRODUCCION
}

enum BillingPaymentMethod {
  CONTADO_EFECTIVO
  CONTADO
  TARJETA
  TRANSFERENCIA
  OTROS
  CUENTA_CORRIENTE
}

enum BillingPaymentStatus {
  IMPAGA
  PARCIALMENTE_PAGA
  PAGA
  ANULADA
}

enum BillingReceiptPaymentMethod {
  EFECTIVO
  CHEQUE
  TRANSFERENCIA
  TARJETA
  OTROS
}

/// Estados fiscales del comprobante (PRD Facturación §26.2).
enum BillingInvoiceFiscalStatus {
  MODO_PRUEBA
  BORRADOR
  PENDIENTE_EMISION
  ENVIANDO_ARCA
  AUTORIZADA
  RECHAZADA
  ERROR_TECNICO
  CANCELADA
  AJUSTADA_NC
  AJUSTADA_ND
  ANULADA_NC
}

enum BillingNoteKind {
  CREDIT
  DEBIT
}

/// Perfil local sincronizado con Supabase Auth (`auth.users.id` → `User.id`).
model User {
  id           String     @id @db.Uuid
  name         String
  email        String     @unique
  role         UserRole   @default(VISITANTE)
  status       UserStatus @default(ACTIVE)
  lastAccessAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs            AuditLog[]
  uploadedFiles        UploadedFile[]
  offlineSyncManifests OfflineSyncManifest[]
  billingReceiptsCreated BillingReceipt[]
  billingNotesCreated  BillingNote[]

  @@index([status])
}

/// Catálogo visible en el directorio privado.
model Catalog {
  id                  String        @id @default(cuid())
  name                String
  description         String?
  coverImagePath      String?
  status              CatalogStatus @default(ACTIVE)
  order               Int           @default(0)
  visibleToNormalUser Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  folders     CatalogFolder[]
  importJobs  ImportJob[]

  @@index([status])
  @@index([order])
  @@index([status, visibleToNormalUser])
}

/// Carpeta dentro de un catálogo (generalmente una hoja Excel).
model CatalogFolder {
  id                  String       @id @default(cuid())
  catalogId           String
  name                String
  description         String?
  coverImagePath      String?
  status              FolderStatus @default(ACTIVE)
  order               Int          @default(0)
  visibleToNormalUser Boolean      @default(true)
  searchConfig        Json?
  filterConfig        Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  catalog    Catalog        @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  columns    FolderColumn[]
  products   Product[]
  importJobs ImportJob[]

  @@unique([catalogId, name])
  @@index([catalogId])
  @@index([catalogId, order])
  @@index([status])
  @@index([visibleToNormalUser])
}

/// Columna configurada dentro de una carpeta.
model FolderColumn {
  id                    String         @id @default(cuid())
  folderId              String
  originalName          String
  displayName           String
  internalKey           String
  dataType              ColumnDataType @default(UNKNOWN)
  order                 Int            @default(0)
  visibleToNormalUser   Boolean        @default(true)
  isSearchable          Boolean        @default(false)
  isGloballySearchable  Boolean        @default(false)
  isFilterable          Boolean        @default(false)
  isGloballyFilterable  Boolean        @default(false)
  isAdminEditable       Boolean        @default(true)
  isPrimaryCode         Boolean        @default(false)
  isEquivalence         Boolean        @default(false)
  isDescription         Boolean        @default(false)
  isImageCode           Boolean        @default(false)
  isRequired            Boolean        @default(false)
  isReadOnly            Boolean        @default(false)
  width                 Int?
  format                String?
  unit                  String?
  label                 String?
  globalFieldKey        String?
  helpText              String?
  helpImagePath         String?
  helpImageThumbnailPath String?
  helpImageMimeType     String?
  helpImageSizeBytes    Int?
  helpImageOriginalName String?
  helpImageAltText      String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  folder CatalogFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([folderId, internalKey])
  @@index([folderId])
  @@index([folderId, order])
  @@index([globalFieldKey])
  @@index([isGloballySearchable])
}

/// Producto (fila de datos) dentro de una carpeta.
model Product {
  id               String   @id @default(cuid())
  folderId         String
  primaryCode      String?
  normalizedCode   String?
  description      String?
  dynamicData      Json     @default("{}")
  originalText            String?  @db.Text
  indexedText             String?  @db.Text
  normalizedIndexedText   String?  @db.Text
  /// Excel source row (1-based). Null for legacy/manual products — list falls back to updatedAt.
  sourceRow               Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  folder            CatalogFolder            @relation(fields: [folderId], references: [id], onDelete: Cascade)
  images            ProductImage[]
  equivalentCodes   EquivalentCode[]
  fieldAnnotations  ProductFieldAnnotation[]

  @@index([folderId])
  @@index([folderId, updatedAt, id])
  @@index([folderId, sourceRow, id])
  @@index([normalizedCode])
  @@index([dynamicData], type: Gin)
}

/// Código equivalente normalizado asociado a un producto.
model EquivalentCode {
  id              String   @id @default(cuid())
  productId       String
  originalCode    String
  normalizedCode  String
  sourceColumnKey String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, normalizedCode])
  @@index([productId])
  @@index([normalizedCode])
}

/// Anotación opcional (imagen + texto) por campo de un producto.
model ProductFieldAnnotation {
  id                     String   @id @default(cuid())
  productId              String
  columnInternalKey      String
  helpText               String?
  helpImagePath          String?
  helpImageThumbnailPath String?
  helpImageMimeType      String?
  helpImageSizeBytes     Int?
  helpImageOriginalName  String?
  helpImageAltText       String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, columnInternalKey])
  @@index([productId])
}

/// Imagen asociada a un producto (embebida, externa o manual).
model ProductImage {
  id              String             @id @default(cuid())
  productId       String?
  importJobId     String?
  storagePath     String?
  thumbnailPath   String?
  originalName    String
  mimeType        String
  sizeBytes       Int                @default(0)
  sortOrder       Int                @default(0)
  isPrimary       Boolean            @default(false)
  label           String?
  sourceSheet     String?
  sourceRow       Int?
  sourceColumn    String?
  status          ProductImageStatus
  source          ProductImageSource
  matchCandidates Json?
  errorMessage    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  product   Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  importJob ImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([importJobId, status])
  @@index([status])
}

/// Archivo Excel respaldado en Storage.
model UploadedFile {
  id           String             @id @default(cuid())
  originalName String
  storagePath  String
  mimeType     String
  sizeBytes    Int
  status       UploadedFileStatus @default(STORED)
  uploadedById String             @db.Uuid
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  uploadedBy User        @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  importJobs ImportJob[]

  @@index([uploadedById])
  @@index([status])
  @@index([createdAt])
}

/// Lista de precios independiente de catálogos (RF-053–059).
model PriceList {
  id                   String          @id @default(cuid())
  name                 String          @unique
  description          String?
  status               PriceListStatus @default(ACTIVE)
  order                Int             @default(0)
  visibleToNormalUser  Boolean         @default(true)
  supplierName         String?
  supplierDate         DateTime?       @db.Date
  sourceUploadedFileId String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  columns    PriceColumn[]
  items      PriceItem[]
  importJobs ImportJob[]

  @@index([status])
  @@index([order])
  @@index([visibleToNormalUser])
}

/// Columna configurada dentro de una lista de precios.
model PriceColumn {
  id                     String         @id @default(cuid())
  priceListId            String
  originalName           String
  displayName            String
  internalKey            String
  dataType               ColumnDataType @default(UNKNOWN)
  order                  Int            @default(0)
  visibleToNormalUser    Boolean        @default(true)
  isSearchable           Boolean        @default(false)
  isFilterable           Boolean        @default(false)
  isAdminEditable        Boolean        @default(true)
  isPrimaryCode          Boolean        @default(false)
  isDescription          Boolean        @default(false)
  isPrice                Boolean        @default(false)
  isRequired             Boolean        @default(false)
  isReadOnly             Boolean        @default(false)
  width                  Int?
  format                 String?
  unit                   String?
  label                  String?
  helpText               String?
  helpImagePath          String?
  helpImageThumbnailPath String?
  helpImageMimeType      String?
  helpImageSizeBytes     Int?
  helpImageOriginalName  String?
  helpImageAltText       String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([priceListId, internalKey])
  @@index([priceListId])
  @@index([priceListId, order])
}

/// Ítem (fila) dentro de una lista de precios.
model PriceItem {
  id             String   @id @default(cuid())
  priceListId    String
  primaryCode    String?
  normalizedCode String?
  description    String?
  amount         Decimal? @db.Decimal(18, 4)
  dynamicData    Json     @default("{}")
  originalText          String?  @db.Text
  indexedText           String?  @db.Text
  normalizedIndexedText String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([priceListId])
  @@index([priceListId, updatedAt, id])
  @@index([normalizedCode])
  @@index([dynamicData], type: Gin)
}

/// Operación de importación Excel hacia una carpeta o lista de precios.
model ImportJob {
  id              String                @id @default(cuid())
  uploadedFileId  String
  destinationType ImportDestinationType @default(CATALOG_FOLDER)
  catalogId       String?
  folderId        String?
  priceListId     String?
  targetSheetName String?
  status          ImportJobStatus       @default(STORED)
  actionType      ImportActionType?
  config          Json?
  resultados      Json?
  progress        Json?
  errorMessage    String?
  startedAt       DateTime              @default(now())
  finishedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  uploadedFile UploadedFile   @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)
  catalog      Catalog?       @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  folder       CatalogFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  priceList    PriceList?     @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  sheets        ImportSheet[]
  preview       ImportPreview?
  productImages ProductImage[]

  @@index([uploadedFileId])
  @@index([status])
  @@index([folderId])
  @@index([catalogId])
  @@index([priceListId])
  @@index([destinationType])
}

/// Hoja detectada durante el análisis de un archivo Excel.
model ImportSheet {
  id             String                    @id @default(cuid())
  importJobId    String
  sheetName      String
  classification ImportSheetClassification
  rowCount       Int                       @default(0)
  columnCount    Int                       @default(0)
  detectedHeaders Json?
  metadata       Json?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([importJobId, sheetName])
  @@index([importJobId])
}

/// Vista previa de productos reconocidos antes de publicar.
model ImportPreview {
  id                 String   @id @default(cuid())
  importJobId        String   @unique
  recognizedProducts Json
  matchedProducts    Json     @default("[]")
  errors             Json     @default("[]")
  warnings           Json     @default("[]")
  summary            Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
}

/// Catálogo de campos globales para búsqueda/filtros cross-catálogo (RF-042).
model GlobalField {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Manifest de sincronización offline por usuario/dispositivo (RF-045–047).
model OfflineSyncManifest {
  id           String   @id @default(cuid())
  userId       String   @db.Uuid
  deviceId     String
  version      Int      @default(1)
  catalogIds   String[]
  folderIds    String[]
  priceListIds String[] @default([])
  syncedAt     DateTime @default(now())
  payloadHash  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

/// Cliente de facturación cargado manualmente (PRD Facturación §8).
model BillingClient {
  id                   String                    @id @default(cuid())
  code                 String                    @unique
  codeNumber           Int                       @unique
  name                 String
  address              String?
  city                 String?
  province             String?
  email                String?
  whatsapp             String?
  identificationType   BillingIdentificationType @default(NINGUNO)
  identificationNumber String?
  ivaCondition         BillingIvaCondition       @default(CONSUMIDOR_FINAL)
  notes                String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  invoices     BillingInvoice[]
  receipts     BillingReceipt[]
  billingNotes BillingNote[]

  @@index([name])
  @@index([identificationType])
  @@index([ivaCondition])
  @@index([identificationNumber])
}

/// Rubro/concepto de facturación (PRD Facturación §9).
model BillingRubro {
  id          String             @id @default(cuid())
  code        String             @unique
  codeNumber  Int                @unique
  name        String             @unique
  description String?
  status      BillingRubroStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  invoiceItems BillingInvoiceItem[]

  @@index([status])
  @@index([name])
}

/// Parámetros fiscales y de facturación. Registro único (PRD Facturación §12, §14, §27).
model BillingFiscalSettings {
  id                 String                   @id
  ivaPercent         Decimal                  @default(21) @db.Decimal(5, 2)
  genericClientLimit Decimal                  @default(400000) @db.Decimal(18, 2)
  pointOfSale        String                   @default("0007")
  environment        BillingFiscalEnvironment @default(MODO_PRUEBA)
  issuerName         String?
  issuerCuit         String?
  issuerAddress      String?
  issuerCity         String?
  issuerProvince     String?
  issuerIvaCondition String?
  issuerGrossIncome  String?
  issuerActivitiesStartedAt String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
}

/// Factura creada en modo prueba o fiscal, con snapshot del cliente (PRD Facturación §13, §23, §24).
model BillingInvoice {
  id             String                     @id @default(cuid())
  environment    BillingFiscalEnvironment   @default(MODO_PRUEBA)
  fiscalStatus   BillingInvoiceFiscalStatus @default(MODO_PRUEBA)
  invoiceType    BillingInvoiceType
  pointOfSale    String
  sequenceNumber Int
  invoiceNumber  String                     @unique
  issuedAt       DateTime                   @default(now())

  clientId                   String?
  clientCode                 String
  clientName                 String
  clientAddress              String?
  clientCity                 String?
  clientProvince             String?
  clientEmail                String?
  clientWhatsapp             String?
  clientIdentificationType   BillingIdentificationType
  clientIdentificationNumber String?
  clientIvaCondition         BillingIvaCondition

  subtotal           Decimal @db.Decimal(18, 2)
  discountPercent    Decimal @default(0) @db.Decimal(5, 2)
  discountAmount     Decimal @default(0) @db.Decimal(18, 2)
  ivaPercent         Decimal @db.Decimal(5, 2)
  ivaAmount          Decimal @db.Decimal(18, 2)
  total              Decimal @db.Decimal(18, 2)
  totalVisualRounded Decimal @db.Decimal(18, 2)

  paymentMethod BillingPaymentMethod
  paymentStatus BillingPaymentStatus @default(IMPAGA)
  notes         String?

  cae          String?
  caeExpiresAt DateTime?
  qrUrl        String?
  pdfPath      String?
  printedAt    DateTime?
  downloadedAt DateTime?
  sharedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client      BillingClient?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items       BillingInvoiceItem[]
  allocations  BillingReceiptAllocation[]
  billingNotes BillingNote[]

  @@unique([environment, pointOfSale, sequenceNumber])
  @@index([issuedAt])
  @@index([clientId])
  @@index([invoiceType])
  @@index([paymentStatus])
  @@index([clientName])
  @@index([clientIdentificationNumber])
}

/// Ítem de factura con snapshot del rubro (PRD Facturación §13.4, §29.4).
model BillingInvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  rubroId     String?
  rubroCode   String
  rubroName   String
  description String
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(18, 2)
  lineTotal   Decimal  @db.Decimal(18, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  invoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  rubro   BillingRubro?  @relation(fields: [rubroId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([rubroId])
}

/// Recibo X interno del cliente. Las facturas se resuelven en allocations.
model BillingReceipt {
  id              String                       @id @default(cuid())
  receiptNumber   String                       @unique
  sequenceNumber  Int                          @unique
  clientId        String
  issuedAt        DateTime                     @default(now())
  amount          Decimal                      @db.Decimal(18, 2)
  paymentMethod   BillingReceiptPaymentMethod
  notes           String?
  createdByUserId String                       @db.Uuid
  printedAt       DateTime?
  downloadedAt    DateTime?
  sharedAt        DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  client      BillingClient              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy   User                       @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  allocations BillingReceiptAllocation[]

  @@index([clientId])
  @@index([issuedAt])
}

/// Imputación de un Recibo X contra una factura (PRD Facturación §29.8).
model BillingReceiptAllocation {
  id         String   @id @default(cuid())
  receiptId  String
  invoiceId  String
  amount     Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())

  receipt BillingReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([receiptId, invoiceId])
  @@index([invoiceId])
}

/// Nota de crédito o débito asociada a una factura (modo prueba).
model BillingNote {
  id             String                   @id @default(cuid())
  kind           BillingNoteKind
  environment    BillingFiscalEnvironment @default(MODO_PRUEBA)
  invoiceType    BillingInvoiceType
  pointOfSale    String
  sequenceNumber Int
  noteNumber     String                   @unique
  issuedAt       DateTime                 @default(now())

  invoiceId String
  clientId  String?

  clientCode                 String
  clientName                 String
  clientIdentificationType   BillingIdentificationType
  clientIdentificationNumber String?
  clientIvaCondition         BillingIvaCondition

  amount      Decimal @db.Decimal(18, 2)
  ivaPercent  Decimal @db.Decimal(5, 2)
  ivaAmount   Decimal @db.Decimal(18, 2)
  netAmount   Decimal @db.Decimal(18, 2)
  reason      String
  pdfPath     String?

  createdByUserId String @db.Uuid
  printedAt       DateTime?
  downloadedAt    DateTime?
  sharedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoice   BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  client    BillingClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy User           @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([kind, sequenceNumber])
  @@index([invoiceId])
  @@index([issuedAt])
  @@index([kind])
  @@index([clientId])
}

/// Registro de operaciones importantes (login, CRUD, importaciones, etc.).
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
